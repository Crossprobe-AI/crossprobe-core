{
  "name": "crossprobe-core",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crossprobe-AI/crossprobe-core.git"
  },
  "homepage": "https://core.crossprobe.ai",
  "bugs": {
    "url": "https://github.com/Crossprobe-AI/crossprobe-core/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "scripts": {
    "build": "tsc -b packages/kicad-sexpr packages/kicad-model",
    "test": "vitest run",
    "dev": "npm run build && npm run dev -w @crossprobe/web",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.test.json",
    "clean": "tsc -b --clean packages/kicad-sexpr packages/kicad-model",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/browser-playwright": "^4.1.12",
    "playwright": "^1.65.1",
    "puppeteer-core": "^25.18.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12",
    "vitest-browser-react": "^2.3.0"
  }
}
