    "rules": [
      {
        "severity": "recommended",
        "text": "Keep the 4.7 uF input and battery capacitors within a few millimetres of the VBUS and VBAT pins, with a short return to ground.",
        "basis": "convention"
      },
      {
        "severity": "recommended",
        "text": "Put the PROG resistor right at pin 5 and keep stray capacitance off that node: it sets the charge current.",
        "basis": "convention"
      },
