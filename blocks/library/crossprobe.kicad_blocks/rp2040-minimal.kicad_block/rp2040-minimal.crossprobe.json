{
  "id": "rp2040-minimal",
  "title": "RP2040 minimal system",
  "description": "RP2040 with the circuit from Raspberry Pi's minimal design: supply decoupling, the internal regulator capacitors, a W25Q128JVS flash, the 12 MHz crystal, USB with series resistors and a BOOTSEL header. It takes 3.3 V from outside.",
  "keywords": [
    "RP2040",
    "Raspberry Pi",
    "Pico",
    "microcontroller",
    "12 MHz crystal",
    "QSPI flash",
    "W25Q128JVS",
    "USB",
    "BOOTSEL",
    "reference design"
  ],
  "category": "MCU",
  "status": "draft",
  "license": "Apache-2.0",
  "seo": {
    "title": "RP2040 minimal reference schematic for KiCad",
    "description": "KiCad schematic for an RP2040 board: flash, 12 MHz crystal, USB, decoupling and BOOTSEL, drawn after Raspberry Pi's minimal design. Free download."
  },
  "sources": [
    {
      "id": "ds",
      "title": "Hardware design with RP2040 (Raspberry Pi Ltd, 2022-2026)",
      "url": "https://datasheets.raspberrypi.com/rp2040/hardware-design-with-rp2040.pdf",
      "publisher": "Raspberry Pi Ltd",
      "note": "Page numbers are the printed ones, one lower than the PDF viewer's. Values are quoted as facts; the circuit is drawn here, not copied."
    },
    {
      "id": "files",
      "title": "RP2040 Minimal KiCad design, R3-S1 (design files)",
      "url": "https://datasheets.raspberrypi.com/rp2040/Minimal-KiCAD.zip",
      "publisher": "Raspberry Pi Ltd",
      "note": "MIT license. Used to check which pins carry which capacitors and the part values."
    }
  ],
  "layout": {
    "footprints": 26,
    "tracks": 0,
    "vias": 0,
    "routed": false,
    "rules": [
      {
        "severity": "recommended",
        "text": "Place each 100 nF capacitor at the supply pin it serves, on the same side of the board as the chip, with the ground end going to the pad through its own via. The 1 uF capacitors for the regulator output and input sit next to pins 45 and 43/44.",
        "basis": "convention"
      },
      {
        "severity": "recommended",
        "text": "Keep the 12 MHz crystal, its two 15 pF capacitors and the 1 k series resistor close to XIN and XOUT (pins 20 and 21), with nothing else routed under them.",
        "basis": "convention"
      },
      {
        "severity": "recommended",
        "text": "Keep the QSPI flash close to the chip and the six QSPI traces short and about equal in length.",
        "basis": "convention"
      },
      {
        "severity": "info",
        "text": "Placement only: the chip's pitch is 0.4 mm, so fan-out depends on your design rules and stack-up. Parts are positioned and the nets are left as a ratsnest. Connect the exposed pad to ground with several vias.",
        "basis": "convention"
      }
    ]
  },
